{
  "trailingSlash": "auto",
  "routes": [
    {
      "route": "/about",
      "rewrite": "/about.html"
    },
    {
      "route": "/franchise", 
      "rewrite": "/franchise.html"
    },
    {
      "route": "/stores",
      "rewrite": "/stores.html"
    },
    {
      "route": "/privacy-policy",
      "rewrite": "/privacy-policy.html"
    },
    {
      "route": "/terms-conditions",
      "rewrite": "/terms-conditions.html"
    },
    {
      "route": "/shipping-policy",
      "rewrite": "/shipping-policy.html"
    },
    {
      "route": "/refund-policy",
      "rewrite": "/refund-policy.html"
    },
    {
      "route": "/*.svg",
      "headers": {
        "Cache-Control": "public, max-age=604800",
        "Content-Type": "image/svg+xml"
      }
    },
    {
      "route": "/*.webp",
      "headers": {
        "Cache-Control": "public, max-age=604800",
        "Content-Type": "image/webp"
      }
    },
    {
      "route": "/*.riv",
      "headers": {
        "Cache-Control": "public, max-age=604800",
        "Content-Type": "application/octet-stream"
      }
    },
    {
      "route": "/fonts/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000"
      }
    },
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000"
      }
    }
  ],
  "responseOverrides": {},
  "mimeTypes": {
    ".json": "application/json",
    ".svg": "image/svg+xml",
    ".woff": "font/woff",
    ".woff2": "font/woff2",
    ".ttf": "font/ttf",
    ".eot": "application/vnd.ms-fontobject",
    ".webp": "image/webp",
    ".riv": "application/octet-stream",
    ".js": "text/javascript",
    ".css": "text/css",
    ".html": "text/html"
  }
}